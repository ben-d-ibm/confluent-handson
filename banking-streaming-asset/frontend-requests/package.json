{
  "name": "frontend-requests",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend (React + Carbon) y backend Express para crear solicitudes de préstamo en loan-requests",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "npm run test:api && npm run test:web",
    "test:api": "node --test test/*.test.js",
    "test:web": "vitest run",
    "build:web": "vite build"
  },
  "dependencies": {
    "@platformatic/kafka": "2.14.0",
    "avsc": "^5.7.9",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@carbon/react": "^1.120.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.107.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
