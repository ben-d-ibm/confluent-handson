# =============================================================================
#  Banca Streaming - configuración del usuario
#  Copia este fichero a `.env` (o ejecuta `make init`) y rellena los valores.
#  NUNCA subas `.env` a git. Los valores con caracteres especiales van entre comillas.
# =============================================================================

# --- Confluent Cloud (OBLIGATORIO) -------------------------------------------
# Cloud API key (NO es una API key de clúster). Créala en:
#   Confluent Cloud > menú superior derecha > API keys > Add API key > Cloud resource management
# Necesita permisos para crear entornos y service accounts (rol OrganizationAdmin).
CONFLUENT_CLOUD_API_KEY=
CONFLUENT_CLOUD_API_SECRET=

# Región de AWS donde se despliega todo (clúster Kafka + Flink).
CLOUD_REGION=us-east-1

# Prefijo para nombrar los recursos creados en Confluent Cloud.
PROJECT_NAME=banking-streaming

# Capacidad máxima del pool de Flink (CFU). Más CFU = más coste potencial.
FLINK_MAX_CFU=5

# --- Entorno local ------------------------------------------------------------
# auto | docker | podman
CONTAINER_RUNTIME=auto

# Puertos locales (siempre enlazados a 127.0.0.1)
POSTGRES_PORT=5432
CONNECT_PORT=8083

# Contraseñas de PostgreSQL. `make init` las genera de forma aleatoria.
POSTGRES_PASSWORD=
CDC_PASSWORD=

# --- watsonx.data (OPCIONAL) --------------------------------------------------
# false: el dashboard lee directamente de Kafka (modo solo Confluent).
# true : Tableflow -> Iceberg -> watsonx.data -> Presto -> dashboard.
ENABLE_WATSONXDATA=false

# Solo se exigen si ENABLE_WATSONXDATA=true
WXD_HOST=
WXD_PORT=
WXD_USER=
WXD_API_KEY=
WXD_CATALOG=
WXD_SCHEMA=
